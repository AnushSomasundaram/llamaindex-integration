# --- Bridge server (bridge/) ---
# The real MeetStream API key. Only the bridge process ever reads this.
MEETSTREAM_API_KEY=
# Override only if MeetStream's API is hosted somewhere other than the default.
MEETSTREAM_BASE_URL=https://api.meetstream.ai/api/v1

# --- llama-index-meetstream package ---
# Sent to the BRIDGE (not to MeetStream) -- see docs/ARCHITECTURE.md §8a.
# Can reuse the same value as MEETSTREAM_API_KEY above for local development.
MEETSTREAM_API_KEY=
MEETSTREAM_BRIDGE_URL=http://localhost:8000

# --- Example scripts only (not required by the package itself) ---
# Used by examples/{rag,agent}_example.py.
OPENAI_API_KEY=
